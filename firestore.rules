rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'garrydavies1963@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId);
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId);

      // User puzzle progress subcollection
      match /progress/{puzzleId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId) && isValidId(puzzleId);
        allow write: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(puzzleId);
      }
    }

    // Puzzles (catalog)
    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(puzzleId);
    }

    // Constellations
    match /constellations/{constellationId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(constellationId);
    }

    // Leaderboard scores
    match /leaderboardScores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(scoreId) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() && isValidId(scoreId);
    }

    // Challenges (Daily and Weekly)
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(challengeId);
    }

    // Admins whitelist
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
